# ==========================================
# LARAVEL DEFAULT
# ==========================================
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed

# ==========================================
# PROJECT MEDIA - TAMBAHAN
# ==========================================

# --- Database & Backup ---
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm
/database/backups/
# (sisa file DB lama di root project — sudah dipindah ke database/)
/db_project_media

# --- Dump & Backup ---
dump-files-*.txt
sprint-dump-*.txt
test-workflow.php
*.sql
*.sql.gz
backup-*.zip

# --- Log ---
*.log
storage/logs/*.log

# --- Upload User ---
storage/app/public/avatars/*
storage/app/public/backgrounds/*
storage/app/public/uploads/*
!storage/app/public/avatars/.gitkeep
!storage/app/public/backgrounds/.gitkeep

# --- Cache & Session ---
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor ---
*.swp
*.swo
*~
